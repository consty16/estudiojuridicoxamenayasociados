# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BREVO_API_KEY: API Key for email sending via Brevo
BREVO_API_KEY="xkeysib-..."

# SUPABASE_URL: The URL of your Supabase project
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: The anonymous key for your Supabase project
SUPABASE_ANON_KEY="your-anon-key-here"

# EMAIL_SENDER: The sender email address (authorized in Brevo)
EMAIL_SENDER="xamenasantiago@hotmail.com"

# EMAIL_RECEIVER: The destination email address
EMAIL_RECEIVER="xamenasantiago@hotmail.com"
